# Settings for deploy/docker-compose.yml. Any setting in walls.toml works here as WALLS_<NAME>.

# Agents must send a bearer token. Leave this unset and the server makes one on first start,
# prints it once in `docker compose logs walls`. Only its hash is kept; if you lose it,
# `docker compose exec walls walls rotate-token` replaces it. Set WALLS_AUTH=false to turn auth off.
# WALLS_AUTH_TOKEN=
WALLS_LLM_URL=https://api.openai.com/v1
WALLS_LLM_KEY=
# Host headers to accept: add the name agents use to reach this server.
WALLS_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
WALLS_PUBLIC_URL=http://127.0.0.1:8797/mcp

# Optional weekly digest, POSTed as JSON. Only the URL is required.
# WALLS_DIGEST_WEBHOOK_URL=
# WALLS_DIGEST_WEBHOOK_TOKEN=
# WALLS_DIGEST_TO=
