[Unit]
Description=tailscaled for walls — gives the service its own tailnet name
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/tailscaled --statedir=/var/lib/tailscale-walls --socket=/run/tailscale-walls.sock --tun=userspace-networking --port=0 --socks5-server=
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
